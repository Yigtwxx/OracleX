# Oracle-X — Docker Compose configuration.
#
#   cp .env.example .env
#
# Compose loads this file automatically: it feeds both ${VAR} interpolation
# (frontend build args) and the backend container's environment.
# Copy real values from backend/.env and frontend/.env.local.

# ── Supabase (required) ─────────────────────────────────────────────────────
# The backend refuses to start without these — config.py validate_required()
# raises so you get a clear startup error instead of 500s on every auth'd call.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_KEY=your-anon-key

# ── Local LLM (Ollama) ──────────────────────────────────────────────────────
# Ollama runs on the host, not in a container: on Apple Silicon a containerised
# Ollama cannot use the Metal GPU, which makes large models unusably slow.
# Until Ollama is installed the backend still starts and only logs a warning.
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=qwen3.6:35b-a3b

# ── Per-user API keys (required for the BYO-key feature) ────────────────────
# Encrypts every key a signed-in reader saves from the profile page before it
# reaches Supabase — LLM provider keys and the data-provider keys below alike.
# Empty means the feature is off: the profile forms refuse to save rather than
# storing anything in plaintext.
#
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# It must match backend/.env when both point at the same Supabase project:
# the rows are shared, so a second key orphans every key already stored.
# Rotating it is not a migration — the old ciphertext becomes unreadable and
# every reader has to re-enter their keys.
LLM_KEY_ENCRYPTION_SECRET=

# ── Optional external APIs ──────────────────────────────────────────────────
ETHERSCAN_API_KEY=

# CoinGecko. Optional, but worth setting: anonymous clients are throttled far
# harder than keyed ones, so without a key the heatmap and market boards spend
# much of their time answering 429 and falling back to cache. A free demo key
# from coingecko.com/en/developers/dashboard is enough — leave the plan as
# "demo" for it, and set "pro" only alongside a paid key, since each key is
# rejected by the other's host.
COINGECKO_API_KEY=
COINGECKO_API_PLAN=demo

# TCMB EVDS — the Turkish CPI series, which is what turns a BIST return real
# rather than nominal. Free key from https://evds2.tcmb.gov.tr. Empty is a
# supported state: every board still renders, in nominal terms, and says so.
# A signed-in reader can supply their own from Profile -> Data Providers.
TCMB_EVDS_API_KEY=

# Coinalyze — full daily open-interest history. Free key from
# https://coinalyze.net/futures-data/api/. Empty falls back to the exchanges'
# own statistics endpoints, which keep about thirty days. Also settable per
# reader from Profile -> Data Providers.
COINALYZE_API_KEY=

# SEC EDGAR wants a contact address on every request, and answers 403 without
# one. Server-only — the ownership board is rebuilt on a schedule with no caller
# attached, so this cannot be set per reader.
# Format: "AppName/1.0 (you@example.com)"
SEC_USER_AGENT=

# ── Feature flags ───────────────────────────────────────────────────────────
USE_REAL_API=True
# Was USE_OLLAMA_AI here, which config.py has never read — the setting is USE_AI,
# and it covers the whole provider chain rather than Ollama specifically.
USE_AI=True

# ── CORS ────────────────────────────────────────────────────────────────────
# Must list the origin the browser loads the frontend from.
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

# ── Request throttling ──────────────────────────────────────────────────────
# Believe `X-Forwarded-For` when identifying a caller for rate limiting.
#
# Leave false for a direct `docker compose up`. Set it to true the moment a
# reverse proxy terminates TLS in front of this stack: without it every request
# arrives from the proxy's address, so all callers share one bucket and one
# reader can exhaust everybody's limit. Never set it true when the container
# port is reachable directly — any client can forge that header.
TRUST_PROXY_HEADERS=false
# ── Admin ───────────────────────────────────────────────────────────────────
# Comma-separated emails that get the admin panel, matched against the verified
# email on the caller's JWT. Empty means nobody — adminship is never granted
# from the database, so this variable is the only way in.
ADMIN_EMAILS=


# ── Scheduler intervals (minutes) ───────────────────────────────────────────
NEWS_FETCH_INTERVAL_MINUTES=2
RAG_INDEX_INTERVAL_MINUTES=30

LOG_LEVEL=INFO

# ── TLS front door (docker-compose.tls.yml) ─────────────────────────────────
# Only needed when running the Caddy overlay:
#
#   docker compose -f docker-compose.yml -f docker-compose.tls.yml up --build -d
#
# Point the domain's A record at this server first — Caddy proves control of it
# to Let's Encrypt on the first request, and a certificate cannot be issued
# before DNS resolves here. ACME_EMAIL is where expiry warnings go.
#
# With the overlay on, Caddy is the only thing publishing a port and serves
# both halves on one origin, so the three URLs below become the same host:
#   NEXT_PUBLIC_API_URL=https://your.domain
#   NEXT_PUBLIC_WS_URL=wss://your.domain/ws/prices
#   CORS_ORIGINS=https://your.domain
DOMAIN=
ACME_EMAIL=

# ── Frontend ────────────────────────────────────────────────────────────────
# These are inlined into the client bundle at build time. The browser resolves
# them, so they must be host-reachable URLs — a Compose service name like
# http://backend:8000 will not work.
# When deploying to a server, change these two and CORS_ORIGINS together.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/prices
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The origin readers load the app from. app/layout.tsx builds `metadataBase`
# from it, so every Open Graph and Twitter card resolves against this — left at
# the default, a deployed site advertises localhost previews that no one else
# can fetch. Change it together with the two URLs above.
NEXT_PUBLIC_SITE_URL=http://localhost:3100
