# ─────────────────────────────────────────────────────────────────────────────
# Oracle-X Backend — Environment Configuration
# Copy this file to `.env` and fill in your own values.
# All variables have sensible defaults except the Supabase credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (required for auth, profiles, community, chat history) ──────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-publishable-anon-key
# Service-role key bypasses RLS — keep it secret, backend only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ── LLM provider ─────────────────────────────────────────────────────────────
# Format: <provider> or <provider>:<model>. Only the FIRST colon separates the
# two, so Ollama tags survive intact (ollama:qwen3.6:35b-a3b).
#
# Supported: ollama, groq, gemini, openai, anthropic, openrouter, deepseek,
#            together, mistral, xai, cerebras, fireworks, perplexity, custom
#
# Examples:
#   LLM_PROVIDER=ollama                              # fully local
#   LLM_PROVIDER=groq:llama-3.3-70b-versatile        # fast + free tier
#   LLM_PROVIDER=gemini:gemini-2.5-flash
LLM_PROVIDER=ollama

# Tried in order when the primary is unusable (unreachable, bad key, unknown
# model, or still rate-limited after its retries). Comma-separated, may be empty.
#   LLM_FALLBACK_PROVIDERS=gemini:gemini-2.5-flash,ollama
LLM_FALLBACK_PROVIDERS=

# Model used when a chain entry omits ":<model>".
LLM_MODEL=qwen3.6:35b-a3b

# Retries per provider before moving down the chain (exponential backoff).
LLM_MAX_RETRIES=3

# Rate limits (HTTP 429). A provider that says "retry in 38s" is waited out only
# if the delay fits LLM_RATE_LIMIT_MAX_WAIT; otherwise the chain moves on. Either
# way the provider is then skipped until its quota window rolls over, so a burst
# of requests does not each rediscover the limit and deepen it.
# Set MAX_WAIT to 60 to ride out free-tier per-minute quotas in full — at the
# cost of stalling that request for a minute.
LLM_RATE_LIMIT_MAX_WAIT=30
# Cooldown applied when the provider gives no delay of its own.
LLM_RATE_LIMIT_COOLDOWN=60
# Cooldown for a spent *daily* budget (Groq TPD/RPD, Gemini free-tier daily cap).
# Providers report these as if they were rolling windows and suggest retrying in
# about a minute, so their delay is ignored in favour of this one.
LLM_DAILY_QUOTA_COOLDOWN=1800

# Encrypts per-user LLM API keys stored in Supabase. Leave empty to disable the
# per-user key feature entirely (keys are never stored in plaintext).
# Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LLM_KEY_ENCRYPTION_SECRET=

# Only for LLM_PROVIDER=custom — a self-hosted vLLM / LM Studio / LiteLLM proxy
# that speaks the OpenAI chat-completions format.
LLM_BASE_URL=
LLM_API_KEY=

# ── Local LLM (Ollama) ───────────────────────────────────────────────────────
# Run `ollama serve`, then `ollama pull <LLM_MODEL>` once.
# qwen3.6:35b-a3b (MoE, ~3B active params): high quality at low latency, needs
# ~24 GB. Drop to qwen3.5:9b on lighter hardware.
OLLAMA_BASE_URL=http://localhost:11434

# How long Ollama keeps the model resident after a request. The default of 5m
# means a quiet period is followed by a reload costing tens of seconds, during
# which calls time out. "-1" pins it until the daemon stops.
OLLAMA_KEEP_ALIVE=30m

# ── LLM provider API keys ────────────────────────────────────────────────────
# Only fill in the one(s) you actually use. A provider whose key is empty is
# skipped, so you can leave the rest blank.
# If a model id below has gone stale, GET /api/llm/status?include_models=true
# lists what the provider currently offers.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
CEREBRAS_API_KEY=
FIREWORKS_API_KEY=
PERPLEXITY_API_KEY=

# ── Optional external API keys ───────────────────────────────────────────────
# Etherscan (on-chain exchange flows). Leave empty to disable.
ETHERSCAN_API_KEY=

# CoinGecko (asset universe, overview, heatmap). Empty uses the anonymous free
# tier — it works, but rate-limits hard enough that the heatmap renews only a
# few coins' repository data per refresh. A free demo key raises that budget.
# Set PLAN=pro only with a paid key; it also switches to pro-api.coingecko.com.
COINGECKO_API_KEY=
COINGECKO_API_PLAN=demo

# ── Ownership board ──────────────────────────────────────────────────────────
# SEC EDGAR requires a User-Agent naming a real contact address on every request
# and answers 403 without one; sustained violations are blocked by IP, which
# takes out the whole deployment rather than just this feature. Leaving this
# empty disables the 13F and Form 4 providers — a missing feature is
# recoverable, a banned address is not.
# Format: "AppName/1.0 (you@example.com)"
SEC_USER_AGENT=

# When the board is rebuilt. Once a day, because every source behind it
# publishes quarterly, monthly or on-event. The timezone is explicit because
# "noon" is a claim about a place and the container clock is UTC.
OWNERSHIP_REFRESH_HOUR=12
OWNERSHIP_REFRESH_TIMEZONE=Europe/Istanbul

# ── Market data ──────────────────────────────────────────────────────────────
# CCXT exchange id the live price WebSocket streams from. Change it if your
# network cannot reach the default: Binance is blocked in several countries and
# fails on load_markets() before any tick arrives. Any CCXT Pro exchange that
# supports watch_tickers works — okx, bybit, kucoin, coinbase, kraken…
STREAM_EXCHANGE=okx

# ── Feature flags ─────────────────────────────────────────────────────────────
USE_REAL_API=true
# Master switch for AI features, whichever provider is configured.
USE_AI=true

# ── CORS (comma-separated allowed frontend origins) ──────────────────────────
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
# ── Admin ───────────────────────────────────────────────────────────────────
# Comma-separated emails that get the admin panel, matched against the verified
# email on the caller's JWT. Empty means nobody — adminship is never granted
# from the database, so this variable is the only way in.
ADMIN_EMAILS=


# ── Background scheduler intervals (minutes) ─────────────────────────────────
NEWS_FETCH_INTERVAL_MINUTES=2
RAG_INDEX_INTERVAL_MINUTES=30
# The heatmap board is rebuilt on this interval in the background, so no user
# request ever waits on CoinGecko's rate-limited per-coin detail calls.
HEATMAP_REFRESH_INTERVAL_MINUTES=5
# Live tab. The broadcast probe pulls ~1 MB per channel and cannot be asked for
# less, so this interval is the feature's one real cost lever. Set it to 0 to
# disable probing entirely: the calendar keeps working and the player falls back
# to YouTube's own channel embed, which needs no probe.
LIVE_STREAM_PROBE_INTERVAL_MINUTES=3
LIVE_EVENTS_REFRESH_INTERVAL_MINUTES=15
# Smallest company whose earnings date earns a calendar row.
LIVE_EARNINGS_MIN_MARKET_CAP=50000000000

# ── Heatmap board ────────────────────────────────────────────────────────────
# How many assets the board resolves, by live market-cap rank.
HEATMAP_COIN_COUNT=50

# ── RAG scoring ──────────────────────────────────────────────────────────────
# How much a retrieved past event counts. Every value here has a working default
# in config.py; uncomment only what you want to change.
#
# Relevance floor as a true cosine. Below it, retrieved history is dropped rather
# than shown weakly. Pick it from measurement, not intuition:
#   cd backend && ./venv/bin/python ../scripts/calibrate_rag_relevance.py
# RAG_MIN_RELEVANCE=0.25
#
# Recency half-lives in days. News goes stale in weeks; a halving or a landmark
# ruling stays instructive for years. The floor stops old structural precedent
# decaying to nothing.
# RAG_RECENCY_HALF_LIFE_NEWS_DAYS=90
# RAG_RECENCY_HALF_LIFE_EVENTS_DAYS=1095
# RAG_RECENCY_HALF_LIFE_PRICES_DAYS=365
# RAG_RECENCY_FLOOR=0.25
#
# Magnitude curve: weight = 1 - exp(-|pct| / scale). Saturating, so one huge
# crash does not outrank everything else by size alone.
# RAG_MAGNITUDE_SCALE_PCT=6.0
#
# Importance weights; keep them summing to 1.0.
# RAG_WEIGHT_RECENCY=0.30
# RAG_WEIGHT_MAGNITUDE=0.35
# RAG_WEIGHT_CLASS=0.20
# RAG_WEIGHT_SYMBOL=0.15
#
# An event whose headline read one way and whose durable outcome went the other
# is the most instructive precedent there is, so it is promoted rather than
# penalised. The smaller boost covers a first reaction that diverged from where
# the price settled.
# RAG_SURPRISE_BOOST=1.40
# RAG_INVERSION_BOOST=1.25
#
# Days after an event at which its outcome is measured. The long end is load
# bearing: XRP peaked ~113 days after the SEC suit, and NVDA was still below its
# pre-DeepSeek price at 90 days but well above it at 365. A set that stops at 90
# labels both of them backwards.
# RAG_OUTCOME_HORIZONS_DAYS=1,7,30,90,180,365
#
# How many extra candidates to retrieve before re-ranking. Re-ranking can only
# reorder what came back, so asking for exactly k defeats the weighting.
# RAG_CANDIDATE_MULTIPLIER=4

# ── Scraping ─────────────────────────────────────────────────────────────────
# Lets the scrape ladder launch a real browser for hosts that serve a JavaScript
# shell (reddit, x, stocktwits — the list is a constant in scrape_service.py).
# Off by default: it needs browser binaries (`./venv/bin/scrapling install`,
# several hundred MB) and costs 6-15s per page. With it off the ladder still
# reads ordinary pages; it just returns "needs a browser" for those hosts.
# SCRAPLING_ALLOW_BROWSER=false

# ── Web search ───────────────────────────────────────────────────────────────
# Seconds a single DuckDuckGo query may take before it is abandoned. The library
# defaults to 5s, short enough that a merely slow backend reads as "no results"
# and the chat turn answers with no web context at all. Keep this below
# chat_service.WEB_TIMEOUT (30s), which bounds the two concurrent queries.
# WEB_SEARCH_TIMEOUT=15

# ── Logging (DEBUG | INFO | WARNING | ERROR) ─────────────────────────────────
LOG_LEVEL=INFO
