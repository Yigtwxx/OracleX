*.local
.vercel

# Debug
*.log
logs/

# ChromaDB / RAG vector stores. A bare `data/` here matched every directory
# named `data` at any depth, which silently swallowed backend/data/*.json too.
# Ignore only the generated stores and their timestamped backups.
backend/data/rag/
backend/data/rag_v2/
backend/data/*.bak-*/
*.sqlite3
*.bin
*.pickle

# Generated runtime caches. asset_registry rewrites these on every backend run
# (see backend/services/asset_registry.py — "on-disk cache"), so tracking them
# produced tens of thousands of diff lines per commit. The services fall back to
# their upstream APIs when a cache file is missing, so a fresh clone still boots.
# Hand-maintained seed data next to them stays tracked: registry/streamers.json,
# registry/ownership_entities.json, registry/ownership_manual_positions.json,
# watchlist.json, eth_address_history.json, analysis_reports.json.
backend/data/liquidations.json
backend/data/ai_notes.json
backend/data/user_notes.json
backend/data/chain_metrics.json
backend/data/news_analyses.json
backend/data/news_attribution.json
backend/data/crypto_symbol_map.json
backend/data/registry/coin_metrics.json
backend/data/registry/coin_sectors.json
backend/data/registry/crypto_universe.json
backend/data/registry/cusip_tickers.json
backend/data/registry/listed_bases.json
backend/data/registry/okx_swaps.json
backend/data/registry/ownership_board.json
backend/data/registry/ownership_snapshots.json
backend/data/registry/spot_pairs.json
backend/data/registry/stock_quotes.json
backend/data/registry/stock_universe.json
backend/data/registry/us_equities.json

# Not a cache: the SMTP relay an admin configured from the Alarm Center. Holds an
# encrypted mailbox password and the alarm-token signing secret; written
# 0600 by services/mail_settings_service.py and never tracked.
backend/data/mail_settings.json

# iCloud Drive sync-conflict copies. The repo lives under an iCloud-synced
# Desktop, which periodically forks a file as "liquidations 5.json" or
# "ai 2.jpg". None of them are read by the app.
* [0-9].*

# Working design notes and implementation plans. Kept locally as a record of
# how decisions were reached; not part of the published repo.
docs/superpowers/

# The pre-refactor CWD-relative cache wrote a second copy of the registry to
# the repo root; anchored here so a stray root-directory launch cannot commit it
# again. Root-anchored on purpose — a bare `data/` would swallow backend/data.
/data/
